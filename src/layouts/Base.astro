---
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { UI, otherLang, type Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  lang?: Lang;
  // True when this page also exists in the other language (home, support).
  translated?: boolean;
}

const { title, description, noindex = false, lang = 'en', translated = false } = Astro.props;
const site = Astro.site!;
// Pages are built as privacy.html but served (and linked) as /privacy.
const path = Astro.url.pathname.replace(/(index)?\.html$/, '');
const canonical = new URL(path || '/', site).href;
const ogImage = new URL(lang === 'nl' ? '/og-nl.png' : '/og.png', site).href;
const ogAlt =
  lang === 'nl'
    ? 'Het NEVERMADE OUTDOOR CLUB-logo naast het motto: Doe wat je nog nooit hebt gedaan.'
    : "The NEVERMADE OUTDOOR CLUB badge next to the motto: Do the things you haven't done yet.";
const other = otherLang(lang, path || '/');
const alternates = translated
  ? { [lang]: canonical, [other.lang]: new URL(other.href, site).href }
  : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="en" href={alternates.en} />
          <link rel="alternate" hreflang="nl" href={alternates.nl} />
          <link rel="alternate" hreflang="x-default" href={alternates.en} />
        </>
      )
    }
    <meta name="theme-color" content="#191c1d" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'nl' ? 'nl_NL' : 'en_GB'} />
    <meta property="og:site_name" content="NEVERMADE OUTDOOR CLUB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">{UI[lang].skip}</a>
    <Header lang={lang} switchHref={other.href} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Header turns solid after the first screen; [data-reveal] elements fade up into view.
      const header = document.querySelector('.site-header');
      const onScroll = () => header?.classList.toggle('scrolled', scrollY > 40);
      onScroll();
      addEventListener('scroll', onScroll, { passive: true });

      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
