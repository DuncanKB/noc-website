---
import Base from '../layouts/Base.astro';
import { DISCORD, INSTAGRAM, INSTAGRAM_HANDLE } from '../links';
import Waitlist from '../components/Waitlist.astro';
import AppShowcase from '../components/AppShowcase.astro';
import ContourBackdrop from '../components/ContourBackdrop.astro';

const manifesto =
  'Ever slept under the stars? Stood on a summit at sunrise? NOC counts the things you’ve never done before, and finds you the people to do them with.';

const firsts = [
  { tag: 'Up', title: 'First summit', line: 'The one where the view finally explains the climb.' },
  { tag: 'Off-road', title: 'First trail run', line: 'Roots, mud, no splits worth mentioning. Worth it anyway.' },
  { tag: 'Before dawn', title: 'First sunrise hike', line: 'Alarm at half four. Headtorch on. Colour at the top.' },
  { tag: 'No roof', title: 'First night outside', line: 'Every sound twice as loud. The morning feels earned.' },
];

const activities = [
  { name: 'Hiking', line: 'First summit. First hut-to-hut. First sunrise from the top.' },
  { name: 'Running', line: 'First 5K. First run in the rain. First run before work.' },
  { name: 'Trail running', line: 'First muddy descent. First run with no road in sight.' },
  { name: 'Cycling', line: 'First col. First gravel loop. First ride to the coast.' },
  { name: 'Climbing', line: 'First outdoor crag. First lead. First multi-pitch.' },
];

// The elevation profile the firsts story draws along (viewBox 0 0 1000 300).
const PROFILE =
  'M0 250 C60 245 90 230 130 205 S200 120 250 95 S300 130 340 160 S420 200 470 175 S540 90 600 70 S660 110 700 150 S760 210 820 190 S900 120 940 110 S980 120 1000 125';
const RIDGE_BACK =
  'L0 230 L90 190 L170 215 L260 150 L330 175 L420 110 L500 160 L590 130 L680 185 L760 120 L850 60 L930 120 L1010 95 L1100 160 L1190 120 L1280 170 L1360 140 L1440 175';
---

<Base
  title="NEVERMADE OUTDOOR CLUB — Do the things you haven't done yet."
  description="NEVERMADE OUTDOOR CLUB (NOC) is an outdoor app and community for chasing your firsts: first summit, first trail run, first sunrise hike, first night outside. Not about being the fastest."
>
  <!-- Hero: a sunrise over volcanic ridges -->
  <section class="hero" aria-labelledby="hero-title" data-hero>
    <div class="sky" aria-hidden="true">
      <div class="layer" style="--depth: 0.12"><div class="glow"></div></div>
      <div class="layer" style="--depth: 0.5">
        <div class="sun"><img src="/club-badge-sun.webp" alt="" width="640" height="640" fetchpriority="high" /></div>
      </div>
      <div class="layer" style="--depth: 0.28">
        <svg class="ridge ridge-back" viewBox="0 0 1440 400" preserveAspectRatio="xMidYMax slice">
          <defs>
            <linearGradient id="rim" x1="0" x2="1">
              <stop offset="0" style="stop-color: var(--orange)" stop-opacity="0.1"></stop>
              <stop offset="0.6" style="stop-color: var(--orange)" stop-opacity="0.95"></stop>
              <stop offset="1" style="stop-color: var(--orange)" stop-opacity="0.1"></stop>
            </linearGradient>
            <linearGradient id="backfill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" style="stop-color: var(--ridge-lit)"></stop>
              <stop offset="0.6" style="stop-color: var(--ridge-back)"></stop>
            </linearGradient>
          </defs>
          <path fill="url(#backfill)" d={`M0 400 ${RIDGE_BACK} L1440 400Z`}></path>
          <path fill="none" stroke="url(#rim)" stroke-width="1.6" d={`M${RIDGE_BACK.slice(1)}`}></path>
        </svg>
      </div>
      <div class="layer" style="--depth: 0.16">
        <svg class="ridge ridge-mid" viewBox="0 0 1440 400" preserveAspectRatio="xMidYMax slice">
          <path
            style="fill: var(--ridge-mid)"
            d="M0 400 L0 290 L120 250 L210 280 L320 220 L430 270 L540 235 L650 290 L760 240 L880 280 L990 225 L1110 275 L1220 245 L1330 285 L1440 255 L1440 400Z"
          ></path>
        </svg>
      </div>
      <svg class="ridge ridge-front" viewBox="0 0 1440 400" preserveAspectRatio="xMidYMax slice">
        <path
          style="fill: var(--page)"
          d="M0 400 L0 340 L160 310 L300 345 L460 300 L620 340 L800 315 L980 350 L1150 310 L1300 335 L1440 315 L1440 400Z"
        ></path>
      </svg>
    </div>

    <div class="wrap hero-content">
      <div>
        <h1 id="hero-title" class="motto">
          <span class="line"><span style="--i: 0">Do the things</span></span>
          <span class="line"><span style="--i: 1">you haven’t</span></span>
          <span class="line"><span class="accent" style="--i: 2">done yet.</span></span>
        </h1>
      </div>
      <div class="hero-foot">
        <p class="lede">
          An outdoor app and community for chasing your firsts: the summit you’ve never stood on, the trail you’ve
          never run, the night you’ve never spent outside.
        </p>
        <div class="cta-row">
          <a class="btn" href={DISCORD} rel="noopener">Join the Discord</a>
          <a class="btn btn-ghost" href="#story">How it works</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Manifesto: words light up as you read -->
  <section class="manifesto" aria-label="What NOC is" data-manifesto>
    <div class="wrap">
      <p class="label label-orange">(01) The idea</p>
      <p class="manifesto-text">
        {
          manifesto.split(' ').map((w) => (
            <>
              <span class:list={['w', { hot: /^(stars\?|sunrise\?|never)$/.test(w) }]}>{w}</span>{' '}
            </>
          ))
        }
      </p>
    </div>
  </section>

  <!-- The firsts story: a route drawn along an elevation profile -->
  <section id="story" class="story" aria-labelledby="story-title" data-story>
    <div class="story-pin">
      <div class="wrap story-inner">
        <div class="story-head">
          <p class="label label-orange">(02) The firsts</p>
          <h2 id="story-title" class="story-title">Every first is a checkpoint.</h2>
        </div>

        <svg class="profile" viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="fade" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" style="stop-color: var(--orange)" stop-opacity="0.22"></stop>
              <stop offset="1" style="stop-color: var(--orange)" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <path d={`${PROFILE} L1000 300 L0 300Z`} fill="url(#fade)"></path>
          <path class="profile-base" d={PROFILE} fill="none" vector-effect="non-scaling-stroke"></path>
          <path class="profile-route" d={PROFILE} fill="none" vector-effect="non-scaling-stroke" data-route></path>
        </svg>
        <div class="pins" aria-hidden="true">
          {firsts.map((_, i) => <span class="pin" data-pin={i}><span class="pin-n">0{i + 1}</span></span>)}
        </div>

        <ol class="firsts">
          {
            firsts.map((f, i) => (
              <li class="first" data-first={i}>
                <span class="first-n" aria-hidden="true">
                  0{i + 1}
                </span>
                <div class="first-body">
                  <span class="label label-orange">{f.tag}</span>
                  <h3>{f.title}</h3>
                  <p>{f.line}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Activities -->
  <section id="activities" class="activities" aria-labelledby="act-title">
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {
          [0, 1].map(() => (
            <span class="marquee-set">
              {activities.map((a) => (
                <>
                  <span>{a.name}</span>
                  <svg class="peak" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18 L12 6 L21 18" /></svg>
                </>
              ))}
            </span>
          ))
        }
      </div>
    </div>
    <div class="wrap">
      <div class="act-head">
        <p class="label label-orange">(03) Outside, your way</p>
        <h2 id="act-title" class="section-title">Five ways to find a first.</h2>
      </div>
      <ol class="act-list">
        {
          activities.map((a, i) => (
            <li class="act">
              <span class="label act-n">0{i + 1}</span>
              <h3 class="act-name">{a.name}</h3>
              <p class="act-line">{a.line}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- The app -->
  <section id="app" class="app" aria-labelledby="app-title">
    <div class="wrap app-grid">
      <div class="app-copy">
        <p class="label label-orange">(04) The app</p>
        <h2 id="app-title" class="section-title">Being built. Right now.</h2>
        <p class="app-text">
          Record outings with GPS, collect your firsts, follow friends and share what you did. Coming to iPhone first,
          with Android after that. Later there will also be NOC+, an optional membership with extras; the details
          aren’t final yet, and the Discord hears first.
        </p>
        <ul class="status" aria-label="Release status">
          <li><span class="dot dot-live" aria-hidden="true"></span><b>iPhone</b><span class="label">In development</span></li>
          <li><span class="dot" aria-hidden="true"></span><b>Android</b><span class="label">Later</span></li>
          <li><span class="dot" aria-hidden="true"></span><b>NOC+</b><span class="label">Planned</span></li>
        </ul>
        <div><Waitlist /></div>
      </div>

      <div class="app-visual"><AppShowcase /></div>
    </div>
  </section>

  <!-- Join -->
  <section id="join" class="join" aria-labelledby="join-title">
    <ContourBackdrop />
    <div class="wrap">
      <p class="label label-orange">(05) Join the club</p>
      <h2 id="join-title" class="join-title">
        Come along<br />before the<br /><span class="accent">app does.</span>
      </h2>
      <p class="join-lede">
        Swap plans, find people to go with, follow the app being built and help shape it.
      </p>
      <div class="join-cards">
        <a class="join-card" href={DISCORD} rel="noopener">
          <span class="label label-orange">Community</span>
          <span class="join-name">Discord</span>
          <span class="join-sub">Join the NOC server</span>
          <span class="join-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="join-card" href={INSTAGRAM} rel="noopener">
          <span class="label label-orange">Follow</span>
          <span class="join-name">Instagram</span>
          <span class="join-sub">{INSTAGRAM_HANDLE}</span>
          <span class="join-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

  // How far an element has travelled through the viewport (0 → 1), between its
  // top reaching `start` (fraction of screen height) and its bottom reaching `end`.
  const progress = (el: Element, start = 1, end = 0) => {
    const r = el.getBoundingClientRect();
    const vh = innerHeight;
    return clamp((vh * start - r.top) / (r.height + vh * (start - end)));
  };

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const manifesto = document.querySelector<HTMLElement>('[data-manifesto]');
  const words = manifesto ? [...manifesto.querySelectorAll<HTMLElement>('.w')] : [];
  const story = document.querySelector<HTMLElement>('[data-story]');
  const route = story?.querySelector<SVGPathElement>('[data-route]') ?? null;
  const pins = story ? [...story.querySelectorAll<HTMLElement>('[data-pin]')] : [];
  const items = story ? [...story.querySelectorAll<HTMLElement>('[data-first]')] : [];
  const STOPS = [0.2, 0.45, 0.68, 0.92];

  if (story && !reduced) story.classList.add('is-pinned');

  // Put the checkpoints on the route line.
  let routeLen = 0;
  const placePins = () => {
    if (!route) return;
    routeLen = route.getTotalLength();
    const svg = route.ownerSVGElement!;
    const host = story!.querySelector<HTMLElement>('.story-inner')!.getBoundingClientRect();
    const box = svg.getBoundingClientRect();
    pins.forEach((pin, i) => {
      const p = route.getPointAtLength(routeLen * STOPS[i]);
      pin.style.left = `${box.left - host.left + (p.x * box.width) / 1000}px`;
      pin.style.top = `${box.top - host.top + (p.y * box.height) / 300}px`;
    });
    route.style.strokeDasharray = `${routeLen}`;
  };

  let ticking = false;
  const frame = () => {
    ticking = false;
    if (hero && !reduced) hero.style.setProperty('--p', progress(hero, 0, -1).toFixed(4));

    if (words.length && manifesto) {
      const lit = reduced ? words.length : Math.round(progress(manifesto, 0.9, 0.45) * words.length * 1.08);
      words.forEach((w, i) => w.classList.toggle('lit', i < lit));
    }

    if (story && route) {
      const pinned = story.classList.contains('is-pinned');
      const r = story.getBoundingClientRect();
      const p = pinned ? clamp(-r.top / (r.height - innerHeight)) : 1;
      route.style.strokeDashoffset = `${routeLen * (1 - p)}`;
      let active = 0;
      STOPS.forEach((s, i) => {
        if (p >= s - 0.05) active = i;
      });
      pins.forEach((pin, i) => pin.classList.toggle('on', p >= STOPS[i] - 0.05));
      items.forEach((it, i) => it.classList.toggle('active', !pinned || i === active));
    }
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(frame);
    }
  };

  placePins();
  frame();
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', () => {
    placePins();
    onScroll();
  });
  document.fonts?.ready.then(() => {
    placePins();
    frame();
  });
</script>

<style>
  /* Hero */
  .hero {
    --p: 0;
    position: relative;
    margin-top: -65px;
    min-height: max(100svh, 640px);
    display: flex;
    overflow: hidden;
    isolation: isolate;
  }
  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(120% 70% at 65% 100%, var(--sky-hot) 0%, var(--sky-warm) 45%, var(--page) 78%);
  }
  .layer {
    position: absolute;
    inset: 0;
    transform: translate3d(0, calc(var(--p) * var(--depth) * 100vh), 0);
  }
  .glow {
    position: absolute;
    left: 78%;
    bottom: 26%;
    width: 120vmax;
    height: 80vmax;
    translate: -50% 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--orange) 60%, transparent),
      color-mix(in srgb, var(--orange) 22%, transparent) 36%,
      color-mix(in srgb, var(--orange) 6%, transparent) 62%,
      transparent
    );
    animation:
      glow-in 2.4s var(--ease-out) both,
      breathe 7s ease-in-out 2.4s infinite;
  }
  @keyframes glow-in {
    from {
      opacity: 0;
      scale: 0.5;
    }
  }
  @keyframes breathe {
    50% {
      opacity: 0.78;
      scale: 1.06;
    }
  }
  .sun {
    position: absolute;
    left: 78%;
    bottom: 22%;
    width: min(38vw, 520px);
    opacity: 0.92;
    filter: drop-shadow(0 0 40px color-mix(in srgb, var(--orange) 45%, transparent));
    translate: -50% 0;
    animation: rise 2.8s var(--ease-out) 0.1s both;
  }
  .sun img {
    width: 100%;
    animation: turn 90s linear infinite;
  }
  @keyframes rise {
    from {
      transform: translateY(70%);
      opacity: 0;
    }
    35% {
      opacity: 1;
    }
  }
  @keyframes turn {
    to {
      transform: rotate(360deg);
    }
  }
  .ridge {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
  }
  .ridge-back {
    height: 64%;
    animation: ridge-in 2.2s var(--ease-out) both;
  }
  .ridge-mid {
    height: 50%;
    animation: ridge-in 2.2s var(--ease-out) 0.08s both;
  }
  .ridge-front {
    height: 40%;
    bottom: -1px;
  }
  @keyframes ridge-in {
    from {
      transform: translateY(12%);
    }
  }

  .hero-content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    padding-top: calc(65px + clamp(28px, 6vh, 80px));
    padding-bottom: clamp(28px, 5vh, 56px);
  }
  .motto {
    margin-top: 18px;
    font-size: min(14.5vw, 12.5rem, 19vh);
    line-height: 0.84;
    letter-spacing: -0.01em;
  }
  .motto .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.05em;
    margin-bottom: -0.05em;
  }
  .motto .line > span {
    display: inline-block;
    white-space: nowrap;
    animation: line-up 1.3s var(--ease-out) both;
    animation-delay: calc(0.2s + var(--i) * 0.12s);
  }
  @keyframes line-up {
    from {
      transform: translateY(108%);
    }
  }
  .accent {
    color: var(--orange);
  }
  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 48px;
    animation: fade-up 1.2s var(--ease-out) 0.75s both;
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
  .lede {
    max-width: 29rem;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.5;
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.6);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (max-width: 760px) {
    /* On phones the sun is placed from the top, just under the motto (whose
       height follows the screen width), so it never rises into the words. */
    .hero {
      --sun-top: calc(65px + clamp(28px, 6vh, 80px) + 24px + 36.6vw + 28px);
      --sun-size: min(56vw, 30svh, 280px);
      min-height: max(100svh, 700px);
    }
    .glow,
    .sun {
      left: 50%;
      bottom: auto;
    }
    .sun {
      top: var(--sun-top);
      width: var(--sun-size);
    }
    /* Keep the sun's space free, so the text below never runs over it. */
    .hero-content > div:first-child {
      padding-bottom: calc(var(--sun-size) + 8px);
    }
    .glow {
      top: calc(var(--sun-top) + var(--sun-size) / 2);
      width: 160vw;
      height: 120vw;
      translate: -50% -50%;
    }
    .ridge-back {
      height: 58%;
    }
    .ridge-mid {
      height: 48%;
    }
    .ridge-front {
      height: 38%;
    }
  }

  /* Manifesto */
  .manifesto {
    padding-block: clamp(96px, 16vw, 200px);
  }
  .manifesto-text {
    margin-top: 28px;
    font-family: var(--display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(2.3rem, 6.4vw, 5.6rem);
    line-height: 0.95;
    max-width: 22ch;
  }
  .w {
    /* Dimmed until read, but still 3:1 against the page (large text). */
    color: var(--dim);
    transition: color 0.35s ease;
  }
  .w.lit {
    color: var(--ice);
  }
  .w.hot.lit {
    color: var(--orange);
  }
  :global(html:not(.js)) .w {
    color: var(--ice);
  }

  /* Story */
  .story {
    position: relative;
    background: linear-gradient(var(--page), var(--story-warm) 50%, var(--page));
  }
  .story-pin {
    padding-block: clamp(64px, 10vw, 120px);
  }
  .story-inner {
    position: relative;
  }
  .story-title {
    margin-top: 14px;
    font-size: clamp(2.6rem, 6.5vw, 5.2rem);
    max-width: 12ch;
  }
  .profile {
    display: block;
    width: 100%;
    height: clamp(120px, 24vh, 260px);
    margin-top: 32px;
    overflow: visible;
  }
  .profile-base {
    stroke: #555;
    stroke-width: 2;
    stroke-dasharray: 2 7;
  }
  .profile-route {
    stroke: var(--orange);
    stroke-width: 3;
    stroke-linecap: round;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--orange) 70%, transparent));
  }
  .pins {
    display: none;
  }
  .firsts {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    gap: 32px;
  }
  .first {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .first-n {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(3.6rem, 9vw, 8rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--orange);
  }
  .first h3 {
    margin-top: 8px;
    font-size: clamp(2.2rem, 5vw, 4.2rem);
  }
  .first p {
    margin-top: 10px;
    max-width: 26rem;
    font-size: 1.1rem;
    color: var(--stone-text);
  }

  /* Pinned: the section is tall, its inside sticks, and scrolling walks the route. */
  .story.is-pinned {
    height: 420vh;
  }
  .is-pinned .story-pin {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 80px 32px;
    overflow: hidden;
  }
  .is-pinned .story-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px 48px;
    align-items: end;
  }
  .is-pinned .profile {
    grid-column: 1 / -1;
    margin-top: 28px;
  }
  .is-pinned .pins {
    display: block;
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .pin {
    position: absolute;
    width: 18px;
    height: 18px;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--page);
    border: 2px solid var(--pin);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.4s ease,
      scale 0.4s var(--ease-out);
  }
  .pin.on {
    background: var(--orange);
    border-color: var(--orange);
    box-shadow:
      0 0 0 8px color-mix(in srgb, var(--orange) 18%, transparent),
      0 0 28px color-mix(in srgb, var(--orange) 80%, transparent);
    scale: 1.15;
  }
  .pin-n {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    translate: -50% 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--stone-text);
  }
