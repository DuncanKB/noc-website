---
import Base from '../layouts/Base.astro';
---

<Base
  title="Off the map — NEVERMADE OUTDOOR CLUB"
  description="This page doesn't exist. Head back to NEVERMADE OUTDOOR CLUB."
  noindex
>
  <section class="wrap lost">
    <p class="label label-orange">Error 404</p>
    <h1>Off the <span>map.</span></h1>
    <p class="lede">
      This page doesn't exist. A first of sorts, but not the kind we're after. Head back to base.
    </p>
    <a class="btn" href="/">Back to the start</a>
  </section>
</Base>

<style>
  .lost {
    min-height: 62vh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 20px;
    padding-block: 72px;
  }
  h1 {
    font-size: clamp(4rem, 16vw, 10rem);
    line-height: 0.85;
  }
  h1 span {
    color: var(--orange);
  }
  .lede {
    max-width: 30rem;
    font-size: 1.1rem;
    margin-bottom: 12px;
  }
</style>
