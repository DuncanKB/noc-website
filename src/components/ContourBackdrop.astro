---
// Moving topographic contour lines behind a section: a slowly drifting noise
// "terrain" with its height lines drawn in a muted orange. Our own small
// WebGL2 shader (no library, nothing sent anywhere). It starts when the
// section comes near, pauses off-screen and in background tabs, draws one
// still frame for reduced motion, and leaves the section's plain background
// where WebGL2 isn't available.
---

<div class="contours" aria-hidden="true" data-contours>
  <canvas></canvas>
</div>

<script>
  const VERT = `#version 300 es
in vec2 p;
void main() { gl_Position = vec4(p, 0.0, 1.0); }`;

  // 2D simplex noise (Ashima Arts / Stefan Gustavson, MIT) and contour lines.
  const FRAG = `#version 300 es
precision highp float;
uniform vec2 uRes;      // canvas size in device pixels
uniform float uDpr;     // device pixel ratio
uniform float uTime;    // seconds
uniform vec3 uColor;    // line colour
out vec4 outColor;

vec3 permute(vec3 x) { return mod(((x * 34.0) + 1.0) * x, 289.0); }
float snoise(vec2 v) {
  const vec4 C = vec4(0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439);
  vec2 i = floor(v + dot(v, C.yy));
  vec2 x0 = v - i + dot(i, C.xx);
  vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
  vec4 x12 = x0.xyxy + C.xxzz;
  x12.xy -= i1;
  i = mod(i, 289.0);
  vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));
  vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
  m = m * m; m = m * m;
  vec3 x = 2.0 * fract(p * C.www) - 1.0;
  vec3 h = abs(x) - 0.5;
  vec3 ox = floor(x + 0.5);
  vec3 a0 = x - ox;
  m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);
  vec3 g;
  g.x = a0.x * x0.x + h.x * x0.y;
  g.yz = a0.yz * x12.xz + h.yz * x12.yw;
  return 130.0 * dot(m, g);
}

void main() {
  // Position in CSS pixels, so the terrain is the same size on every screen.
  vec2 q = gl_FragCoord.xy / uDpr / 520.0;
  float t = uTime;
  // Two octaves of slowly drifting terrain.
  float h = snoise(q + vec2(t * 0.018, t * 0.011)) * 0.7
          + snoise(q * 2.3 - vec2(t * 0.012, -t * 0.016)) * 0.3;
  // Height lines: one every 1/levels of height, about 1.1 CSS px wide.
  float v = h * 7.0;
  float f = abs(fract(v) - 0.5);
  float d = (0.5 - f) / fwidth(v);           // distance to the nearest line, in device px
  float w = 0.55 * uDpr;                     // half the line width
  float line = 1.0 - smoothstep(w, w + 1.0, d);
  outColor = vec4(uColor * line, line);      // premultiplied: the page shows through
}`;

  function shader(gl: WebGL2RenderingContext, type: number, src: string) {
    const s = gl.createShader(type)!;
    gl.shaderSource(s, src);
    gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) ?? 'shader');
    return s;
  }

  for (const host of document.querySelectorAll<HTMLElement>('[data-contours]')) {
    const canvas = host.querySelector('canvas')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const start = () => {
      const gl = canvas.getContext('webgl2', { premultipliedAlpha: true, antialias: false, alpha: true });
      if (!gl) return; // no WebGL2: the plain background stays

      const prog = gl.createProgram()!;
      gl.attachShader(prog, shader(gl, gl.VERTEX_SHADER, VERT));
      gl.attachShader(prog, shader(gl, gl.FRAGMENT_SHADER, FRAG));
      gl.linkProgram(prog);
      if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
      gl.useProgram(prog);

      // One triangle that covers the whole canvas.
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

      const uRes = gl.getUniformLocation(prog, 'uRes');
      const uDpr = gl.getUniformLocation(prog, 'uDpr');
      const uTime = gl.getUniformLocation(prog, 'uTime');
      // Pumpkin orange at about 30% over the page: a quiet line.
      gl.uniform3f(gl.getUniformLocation(prog, 'uColor'), 0.31, 0.165, 0.09);

      // Capped pixel ratio: sharp enough, and easy on phone GPUs.
      const dpr = Math.min(devicePixelRatio || 1, 1.5);
      const resize = () => {
        const r = canvas.getBoundingClientRect();
        canvas.width = Math.max(1, Math.round(r.width * dpr));
        canvas.height = Math.max(1, Math.round(r.height * dpr));
        gl.viewport(0, 0, canvas.width, canvas.height);
        gl.uniform2f(uRes, canvas.width, canvas.height);
        gl.uniform1f(uDpr, dpr);
      };

      // A fixed starting time so every visit begins with the same terrain.
      const t0 = performance.now() - 40_000;
      const draw = (now: number) => {
        gl.uniform1f(uTime, (now - t0) / 1000);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
      };

      let visible = false;
      let raf = 0;
      const loop = (now: number) => {
        draw(now);
        raf = visible && !document.hidden ? requestAnimationFrame(loop) : 0;
      };
      const kick = () => {
        if (reduced) return draw(performance.now());
        if (!raf && visible && !document.hidden) raf = requestAnimationFrame(loop);
      };

      new ResizeObserver(() => {
        resize();
        if (reduced || !raf) draw(performance.now());
      }).observe(canvas);
      new IntersectionObserver((entries) => {
        visible = entries.some((e) => e.isIntersecting);
        kick();
      }).observe(host);
      document.addEventListener('visibilitychange', kick);

      resize();
      draw(performance.now());
      host.classList.add('on');
    };

    // Set up only once the section is close.
    new IntersectionObserver(
      (entries, io) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        try {
          start();
        } catch {
          host.classList.remove('on');
        }
      },
      { rootMargin: '300px 0px' },
    ).observe(host);
  }
</script>

<style>
  .contours {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s ease;
    /* Fade the lines out towards the top, so the heading reads clean. */
    mask-image: linear-gradient(to bottom, transparent 10%, #000 70%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 10%, #000 70%);
  }
  .contours.on {
    opacity: 1;
  }
  canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
