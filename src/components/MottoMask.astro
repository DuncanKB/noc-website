---
// PREVIEW: the end of the motto in giant letters, with an outdoor scene seen
// only through the letters. The layers inside move at different speeds as you
// scroll. The scene is drawn in code (a placeholder): a real summit or trail
// photo can go in its place (one <image> in the scene below).
// Two layouts: two wide lines, or three stacked lines on phones.
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const label = lang === 'nl' ? 'Doe wat je nog nooit hebt gedaan.' : 'Do the things you haven’t done yet.';

type Line = { text: string; y: number; fit?: number };
const LAYOUTS: { id: string; height: number; lines: Line[] }[] = [
  {
    id: 'wide',
    height: 760,
    lines:
      lang === 'nl'
        ? [{ text: 'NOG NOOIT', y: 345, fit: 960 }, { text: 'GEDAAN.', y: 700, fit: 960 }]
        : [{ text: 'HAVEN’T', y: 345, fit: 960 }, { text: 'DONE YET.', y: 700, fit: 960 }],
  },
  {
    id: 'tall',
    height: 1180,
    lines:
      lang === 'nl'
        ? [{ text: 'NOG', y: 360 }, { text: 'NOOIT', y: 750, fit: 940 }, { text: 'GEDAAN.', y: 1140, fit: 960 }]
        : [{ text: 'HAVEN’T', y: 360, fit: 960 }, { text: 'DONE', y: 750 }, { text: 'YET.', y: 1140 }],
  },
];

// Ridges, back to front (drawn for a 1000 × 760 box, stretched for the tall layout).
const RIDGES = [
  { d: 'M0 520 L80 470 L150 495 L240 400 L300 430 L380 350 L460 420 L540 380 L610 300 L660 330 L720 270 L800 360 L880 330 L1000 410 L1000 760 L0 760Z', fill: '#8a3a12', depth: 0.12 },
  { d: 'M0 560 L110 500 L200 540 L300 470 L390 520 L470 460 L560 530 L650 480 L760 540 L860 470 L1000 520 L1000 760 L0 760Z', fill: '#5e2914', depth: 0.25 },
  { d: 'M0 620 L130 560 L250 600 L360 545 L470 610 L600 560 L720 620 L840 570 L1000 610 L1000 760 L0 760Z', fill: '#3c2119', depth: 0.42 },
  { d: 'M0 700 L160 640 L300 680 L420 650 L520 690 L640 640 L760 680 L900 650 L1000 670 L1000 760 L0 760Z', fill: '#2a1d1b', depth: 0.65 },
];

---

<section class="mask" aria-label={label} data-mask>
  <div class="mask-pin">
    {
      LAYOUTS.map((layout) => (
        <svg class:list={['mask-svg', layout.id]} viewBox={`0 0 1000 ${layout.height}`} aria-hidden="true">
          <defs>
            <clipPath id={`letters-${layout.id}`}>
              {layout.lines.map((l) => (<text x="500" y={l.y} text-anchor="middle" textLength={l.fit} lengthAdjust={l.fit ? 'spacingAndGlyphs' : undefined}>{l.text}</text>))}
            </clipPath>
            <linearGradient id={`dawn-${layout.id}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#2b1a24" />
              <stop offset="0.35" stop-color="#9a3410" />
              <stop offset="0.6" stop-color="#fd6002" />
              <stop offset="0.8" stop-color="#ffb066" />
            </linearGradient>
            <radialGradient id={`sun-${layout.id}`}>
              <stop offset="0" stop-color="#fff3e0" />
              <stop offset="0.25" stop-color="#ffc27a" stop-opacity="0.9" />
              <stop offset="1" stop-color="#fd6002" stop-opacity="0" />
            </radialGradient>
          </defs>
          <g clip-path={`url(#letters-${layout.id})`}>
            <g transform={`scale(1 ${layout.height / 760})`}>
              <g data-depth="0">
                <rect x="0" y="-200" width="1000" height="1160" fill={`url(#dawn-${layout.id})`} />
              </g>
              <g data-depth="-0.35">
                <circle cx="640" cy="330" r="260" fill={`url(#sun-${layout.id})`} />
              </g>
              {RIDGES.map((r) => (
                <g data-depth={r.depth}>
                  <path d={r.d} fill={r.fill} />
                </g>
              ))}
            </g>
          </g>
          {/* A faint outline, so the letters read where the scene is dark. */}
          <g class="mask-outline">
            {layout.lines.map((l) => (<text x="500" y={l.y} text-anchor="middle" textLength={l.fit} lengthAdjust={l.fit ? 'spacingAndGlyphs' : undefined}>{l.text}</text>))}
          </g>
        </svg>
      ))
    }
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-mask]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (section && !reduced) {
    const svgs = [...section.querySelectorAll<SVGSVGElement>('svg')];
    const layers = [...section.querySelectorAll<SVGGElement>('[data-depth]')].map((g) => ({
      g,
      depth: Number(g.dataset.depth),
    }));
    let ticking = false;
    const frame = () => {
      ticking = false;
      const r = section.getBoundingClientRect();
      // -1 when the section enters from below, +1 when it leaves at the top.
      const p = Math.max(-1, Math.min(1, (innerHeight / 2 - (r.top + r.height / 2)) / ((r.height + innerHeight) / 2)));
      layers.forEach(({ g, depth }) => g.setAttribute('transform', `translate(0 ${(-p * depth * 260).toFixed(1)})`));
      svgs.forEach((svg) => (svg.style.transform = `scale(${(1 + Math.max(0, p) * 0.12).toFixed(4)})`));
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(frame);
        }
      },
      { passive: true },
    );
    frame();
  }
</script>

<style>
  .mask {
    position: relative;
    height: 170vh;
  }
  .mask-pin {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: 0 var(--gutter);
  }
  .mask-svg {
    grid-area: 1 / 1;
    width: min(100%, 1400px, 150svh);
    height: auto;
    overflow: visible;
    will-change: transform;
  }
  .tall {
    display: none;
    width: min(100%, 64svh);
  }
  @media (max-width: 600px) {
    .wide {
      display: none;
    }
    .tall {
      display: block;
    }
  }
  text {
    font-family: var(--display);
    font-weight: 700;
    font-size: 400px;
    letter-spacing: -0.01em;
  }
  .mask-outline text {
    fill: none;
    stroke: color-mix(in srgb, var(--ice) 14%, transparent);
    stroke-width: 1.5;
  }
  @media (prefers-reduced-motion: reduce) {
    .mask {
      height: auto;
    }
    .mask-pin {
      position: static;
      height: auto;
      padding-block: 96px;
    }
  }
</style>
