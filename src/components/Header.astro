---
const home = Astro.url.pathname === '/';
const link = (hash: string) => (home ? hash : `/${hash}`);
---

<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="/" aria-label="NEVERMADE OUTDOOR CLUB, home">
      <img src="/club-badge-96.webp" alt="" width="40" height="40" />
      <span class="brand-text">NEVERMADE<br />OUTDOOR CLUB</span>
    </a>
    <nav aria-label="Main">
      <ul>
        <li class="hide-sm"><a href={link('#story')}>How it works</a></li>
        <li class="hide-sm"><a href={link('#app')}>The app</a></li>
        <li><a class="btn btn-small" href={link('#waitlist')}>Get the app</a></li>
      </ul>
    </nav>
  </div>
</header>
