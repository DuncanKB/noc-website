---
// The home page, in English (src/pages/index.astro → /) and Dutch
// (src/pages/nl/index.astro → /nl). All its words are in COPY below; keep the
// two languages saying the same thing.
import Base from '../layouts/Base.astro';
import { DISCORD, INSTAGRAM, INSTAGRAM_HANDLE } from '../links';
import { UI, type Lang } from '../i18n';
import Waitlist from './Waitlist.astro';
import AppShowcase from './AppShowcase.astro';
import ContourBackdrop from './ContourBackdrop.astro';
import ParticleRidge from './ParticleRidge.astro';
import FirstsMountain from './FirstsMountain.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const COPY = {
  en: {
    title: 'NEVERMADE OUTDOOR CLUB — Do the things you haven’t done yet.',
    description:
      'NEVERMADE OUTDOOR CLUB (NOC) is an outdoor app and community for chasing your firsts: first summit, first trail run, first sunrise hike, first night outside. Not about being the fastest.',
    motto: ['Do the things', 'you haven’t', 'done yet.'],
    lede: 'An outdoor app and community for chasing your firsts: the summit you’ve never stood on, the trail you’ve never run, the night you’ve never spent outside.',
    ideaAria: 'What NOC is',
    idea: '(01) The idea',
    manifesto:
      'Ever slept under the stars? Stood on a summit at sunrise? NOC counts the things you’ve never done before, and finds you the people to do them with.',
    hot: ['stars?', 'sunrise?', 'never'],
    firstsLabel: '(02) The firsts',
    firstsTitle: 'Every first is a checkpoint.',
    firsts: [
      { tag: 'Up', title: 'First summit', line: 'The one where the view finally explains the climb.' },
      { tag: 'Off-road', title: 'First trail run', line: 'Roots, mud, no splits worth mentioning. Worth it anyway.' },
      { tag: 'Before dawn', title: 'First sunrise hike', line: 'Alarm at half four. Headtorch on. Colour at the top.' },
      { tag: 'No roof', title: 'First night outside', line: 'Every sound twice as loud. The morning feels earned.' },
    ],
    actLabel: '(03) Outside, your way',
    actTitle: 'Five ways to find a first.',
    activities: [
      { name: 'Hiking', line: 'First summit. First hut-to-hut. First sunrise from the top.' },
      { name: 'Running', line: 'First 5K. First run in the rain. First run before work.' },
      { name: 'Trail running', line: 'First muddy descent. First run with no road in sight.' },
      { name: 'Cycling', line: 'First col. First gravel loop. First ride to the coast.' },
      { name: 'Climbing', line: 'First outdoor crag. First lead. First multi-pitch.' },
    ],
    appLabel: '(04) The app',
    appTitle: 'iPhone first. Android next.',
    appPoints: [
      'Record walks, runs, hikes and rides with GPS.',
      'Find waymarked routes wherever you are, and follow them.',
      'Collect your firsts: every new summit, trail and night outside.',
      'Share them with friends, or keep them to yourself.',
    ],
    appPlus: 'Later: NOC+, an optional membership with extras. The details aren’t final yet.',
    statusAria: 'Release status',
    status: ['In development', 'Later', 'Planned'],
    joinLabel: '(05) Join the club',
    join: ['Come along', 'before the', 'app does.'],
    joinLede: 'Leave your email and you’re among the first in when the iPhone app opens.',
    joinMeanwhile: 'Until then, swap plans and find people to go with:',
    community: 'Community',
    discordSub: 'Join the NOC server',
    follow: 'Follow',
  },
  nl: {
    title: 'NEVERMADE OUTDOOR CLUB — Doe wat je nog nooit hebt gedaan.',
    description:
      'NEVERMADE OUTDOOR CLUB (NOC) is een outdoor-app en community voor je eerste keren: je eerste top, eerste trailrun, eerste zonsopgangtocht, eerste nacht buiten. Niet om wie het snelst is.',
    motto: ['Doe wat je', 'nog nooit', 'hebt gedaan.'],
    lede: 'Een outdoor-app en community voor je eerste keren: de top waar je nooit op stond, het pad dat je nooit liep, de nacht die je nooit buiten doorbracht.',
    ideaAria: 'Wat NOC is',
    idea: '(01) Het idee',
    manifesto:
      'Ooit onder de sterren geslapen? Bij zonsopgang op een top gestaan? NOC telt de dingen die je nog nooit hebt gedaan, en vindt de mensen om ze mee te doen.',
    hot: ['sterren', 'zonsopgang', 'nooit'],
    firstsLabel: '(02) De eerste keren',
    firstsTitle: 'Elke eerste keer is een checkpoint.',
    firsts: [
      { tag: 'Omhoog', title: 'Eerste top', line: 'Die ene waar het uitzicht eindelijk de klim verklaart.' },
      { tag: 'Onverhard', title: 'Eerste trailrun', line: 'Wortels, modder, geen tijden om over op te scheppen. Toch de moeite waard.' },
      { tag: 'Voor dag en dauw', title: 'Eerste zonsopgangtocht', line: 'Wekker om half vijf. Hoofdlamp aan. Kleur op de top.' },
      { tag: 'Geen dak', title: 'Eerste nacht buiten', line: 'Elk geluid twee keer zo hard. De ochtend voelt verdiend.' },
    ],
    actLabel: '(03) Buiten, op jouw manier',
    actTitle: 'Vijf manieren om een eerste keer te vinden.',
    activities: [
      { name: 'Hiken', line: 'Eerste top. Eerste huttentocht. Eerste zonsopgang vanaf de top.' },
      { name: 'Hardlopen', line: 'Eerste 5K. Eerste rondje in de regen. Eerste run voor werk.' },
      { name: 'Trailrunning', line: 'Eerste modderige afdaling. Eerste run zonder weg in zicht.' },
      { name: 'Fietsen', line: 'Eerste col. Eerste gravelrondje. Eerste rit naar de kust.' },
      { name: 'Klimmen', line: 'Eerste buitenrots. Eerste voorklim. Eerste multipitch.' },
    ],
    appLabel: '(04) De app',
    appTitle: 'Eerst iPhone. Dan Android.',
    appPoints: [
      'Leg wandelingen, hardlooprondjes, hikes en fietstochten vast met gps.',
      'Vind bewegwijzerde routes waar je ook bent, en volg ze.',
      'Verzamel je eerste keren: elke nieuwe top, elk nieuw pad, elke nacht buiten.',
      'Deel ze met vrienden, of houd ze voor jezelf.',
    ],
    appPlus: 'Later: NOC+, een optioneel lidmaatschap met extra’s. De details staan nog niet vast.',
    statusAria: 'Status van de release',
    status: ['In ontwikkeling', 'Later', 'Gepland'],
    joinLabel: '(05) Word lid',
    join: ['Kom mee', 'voordat de', 'app er is.'],
    joinLede: 'Laat je e-mailadres achter en je bent er als een van de eersten bij als de iPhone-app opengaat.',
    joinMeanwhile: 'Tot die tijd: wissel plannen uit en vind mensen om mee op pad te gaan:',
    community: 'Community',
    discordSub: 'Kom in de NOC-server',
    follow: 'Volg',
  },
};
const c = COPY[lang];
const { manifesto, firsts, activities } = c;

---

<Base title={c.title} description={c.description} lang={lang} translated>
  <!-- Hero: a field of glowing particles forming a volcanic ridge -->
  <section class="hero" aria-labelledby="hero-title" data-hero>
    <div class="sky" aria-hidden="true">
      <div class="layer" style="--depth: 0.2">
        <ParticleRidge />
      </div>
    </div>

    <div class="wrap hero-content">
      <div>
        <h1 id="hero-title" class="motto">
          <span class="line"><span style="--i: 0">{c.motto[0]}</span></span>
          <span class="line"><span style="--i: 1">{c.motto[1]}</span></span>
          <span class="line"><span class="accent" style="--i: 2">{c.motto[2]}</span></span>
        </h1>
      </div>
      <div class="hero-foot">
        <p class="lede">{c.lede}</p>
        <div class="hero-signup">
          <p class="coming-soon"><span class="dot dot-live" aria-hidden="true"></span>{UI[lang].waitlist.label}</p>
          <a class="btn" href="#waitlist">{UI[lang].getTheApp}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Manifesto: words light up as you read -->
  <section class="manifesto" aria-label={c.ideaAria} data-manifesto>
    <div class="wrap">
      <p class="label label-orange">{c.idea}</p>
      <p class="manifesto-text">
        {
          manifesto.split(' ').map((w) => (
            <>
              <span class:list={['w', { hot: c.hot.includes(w) }]}>{w}</span>{' '}
            </>
          ))
        }
      </p>
    </div>
  </section>

  <!-- The firsts story: a route climbs a particle mountain as you scroll -->
  <section id="story" class="story" aria-labelledby="story-title" data-story>
    <div class="story-pin">
      <div class="wrap story-inner">
        <div class="story-head">
          <p class="label label-orange">{c.firstsLabel}</p>
          <h2 id="story-title" class="story-title">{c.firstsTitle}</h2>
        </div>

        <ol class="firsts">
          {
            firsts.map((f, i) => (
              <li class="first" data-first={i}>
                <span class="first-n" aria-hidden="true">
                  0{i + 1}
                </span>
                <div class="first-body">
                  <span class="label label-orange">{f.tag}</span>
                  <h3>{f.title}</h3>
                  <p>{f.line}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <FirstsMountain count={firsts.length} />
    </div>
  </section>

  <!-- Activities -->
  <section id="activities" class="activities" aria-labelledby="act-title">
    <div class="wrap">
      <div class="act-head">
        <p class="label label-orange">{c.actLabel}</p>
        <h2 id="act-title" class="section-title">{c.actTitle}</h2>
      </div>
      <ol class="act-list">
        {
          activities.map((a, i) => (
            <li class="act">
              <span class="label act-n">0{i + 1}</span>
              <h3 class="act-name">{a.name}</h3>
              <p class="act-line">{a.line}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- The app -->
  <section id="app" class="app" aria-labelledby="app-title">
    <div class="wrap app-grid">
      <div class="app-copy">
        <p class="label label-orange">{c.appLabel}</p>
        <h2 id="app-title" class="section-title">{c.appTitle}</h2>
        <ul class="app-points">
          {c.appPoints.map((point) => <li>{point}</li>)}
        </ul>
        <ul class="status" aria-label={c.statusAria}>
          <li><span class="dot dot-live" aria-hidden="true"></span><b>iPhone</b><span class="label">{c.status[0]}</span></li>
          <li><span class="dot" aria-hidden="true"></span><b>Android</b><span class="label">{c.status[1]}</span></li>
          <li><span class="dot" aria-hidden="true"></span><b>NOC+</b><span class="label">{c.status[2]}</span></li>
        </ul>
        <p class="app-plus">{c.appPlus}</p>
      </div>

      <div class="app-visual"><AppShowcase lang={lang} /></div>
    </div>
  </section>

  <!-- Join -->
  <section id="join" class="join" aria-labelledby="join-title">
    <ContourBackdrop />
    <div class="wrap">
      <p class="label label-orange">{c.joinLabel}</p>
      <h2 id="join-title" class="join-title">
        {c.join[0]}<br />{c.join[1]}<br /><span class="accent">{c.join[2]}</span>
      </h2>
      <p class="join-lede">{c.joinLede}</p>
      <Waitlist lang={lang} />
      <p class="join-meanwhile">{c.joinMeanwhile}</p>
      <div class="join-cards">
        <a class="join-card" href={DISCORD} rel="noopener">
          <span class="label label-orange">{c.community}</span>
          <span class="join-name">Discord</span>
          <span class="join-sub">{c.discordSub}</span>
          <span class="join-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="join-card" href={INSTAGRAM} rel="noopener">
          <span class="label label-orange">{c.follow}</span>
          <span class="join-name">Instagram</span>
          <span class="join-sub">{INSTAGRAM_HANDLE}</span>
          <span class="join-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

  // How far an element has travelled through the viewport (0 → 1), between its
  // top reaching `start` (fraction of screen height) and its bottom reaching `end`.
  const progress = (el: Element, start = 1, end = 0) => {
    const r = el.getBoundingClientRect();
    const vh = innerHeight;
    return clamp((vh * start - r.top) / (r.height + vh * (start - end)));
  };

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const manifesto = document.querySelector<HTMLElement>('[data-manifesto]');
  const words = manifesto ? [...manifesto.querySelectorAll<HTMLElement>('.w')] : [];
  const story = document.querySelector<HTMLElement>('[data-story]');
  const pins = story ? [...story.querySelectorAll<HTMLElement>('[data-pin]')] : [];
  const items = story ? [...story.querySelectorAll<HTMLElement>('[data-first]')] : [];
  const STOPS = [0.2, 0.45, 0.68, 0.92];

  if (story && !reduced) story.classList.add('is-pinned');

  let ticking = false;
  const frame = () => {
    ticking = false;
    if (hero && !reduced) hero.style.setProperty('--p', progress(hero, 0, -1).toFixed(4));

    if (words.length && manifesto) {
      const lit = reduced ? words.length : Math.round(progress(manifesto, 0.9, 0.45) * words.length * 1.08);
      words.forEach((w, i) => w.classList.toggle('lit', i < lit));
    }

    if (story) {
      const pinned = story.classList.contains('is-pinned');
      const r = story.getBoundingClientRect();
      const p = pinned ? clamp(-r.top / (r.height - innerHeight)) : 1;
      story.dispatchEvent(new CustomEvent('route-progress', { detail: p }));
      let active = 0;
      STOPS.forEach((s, i) => {
        if (p >= s - 0.05) active = i;
      });
      pins.forEach((pin, i) => pin.classList.toggle('on', p >= STOPS[i] - 0.05));
      items.forEach((it, i) => it.classList.toggle('active', !pinned || i === active));
    }
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(frame);
    }
  };

  frame();
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
</script>

<style>
  /* Hero */
  .hero {
    --p: 0;
    position: relative;
    margin-top: -65px;
    min-height: max(100svh, 640px);
    display: flex;
    overflow: hidden;
    isolation: isolate;
  }
  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(110% 60% at 60% 85%, var(--sky-warm) 0%, var(--page) 70%);
  }
  .layer {
    position: absolute;
    inset: 0;
    transform: translate3d(0, calc(var(--p) * var(--depth) * 100vh), 0);
  }

  .hero-content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    padding-top: calc(65px + clamp(28px, 6vh, 80px));
    padding-bottom: clamp(28px, 5vh, 56px);
  }
  .motto {
    margin-top: 18px;
    font-size: min(14.5vw, 12.5rem, 19vh);
    line-height: 0.84;
    letter-spacing: -0.01em;
  }
  .motto .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.05em;
    margin-bottom: -0.05em;
  }
  .motto .line > span {
    display: inline-block;
    white-space: nowrap;
    /* Quick: the words are readable within about 0.3 s, even on a phone. */
    animation: line-up 0.5s var(--ease-out) both;
    animation-delay: calc(var(--i) * 0.04s);
  }
  @keyframes line-up {
    from {
      transform: translateY(60%);
      opacity: 0;
    }
  }
  .accent {
    color: var(--orange);
  }
  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 48px;
    animation: fade-up 0.6s var(--ease-out) 0.1s both;
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
  .lede {
    max-width: 29rem;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.5;
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.6);
  }
  .hero-signup {
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  /* The one line that says the app isn't out yet: clear, with the same live
     dot as "iPhone · In development" further down. */
  .coming-soon {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ice);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.7);
  }
  @media (max-width: 760px) {
    .hero {
      min-height: max(100svh, 700px);
    }
    /* On a phone the words sit over the bright ridge: a dark veil behind them
       keeps them readable while the ridge still shows above. */
    .sky::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, transparent 30%, color-mix(in srgb, var(--page) 78%, transparent) 55%, var(--page) 85%);
      pointer-events: none;
    }
  }

  /* Manifesto */
  .manifesto {
    padding-block: clamp(96px, 16vw, 200px);
  }
  .manifesto-text {
    margin-top: 28px;
    font-family: var(--display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(2.3rem, 6.4vw, 5.6rem);
    line-height: 0.95;
    max-width: 22ch;
  }
  .w {
    /* Dimmed until read, but still 3:1 against the page (large text). */
    color: var(--dim);
    transition: color 0.35s ease;
  }
  .w.lit {
    color: var(--ice);
  }
  .w.hot.lit {
    color: var(--orange);
  }
  :global(html:not(.js)) .w {
    color: var(--ice);
  }

  /* Story */
  .story {
    position: relative;
    background: linear-gradient(var(--page), var(--story-warm) 50%, var(--page));
  }
  .story-pin {
    padding-block: clamp(64px, 10vw, 120px);
  }
  .story-inner {
    position: relative;
  }
  .story-title {
    margin-top: 14px;
    font-size: clamp(2.6rem, 6.5vw, 5.2rem);
    max-width: 12ch;
  }
  .firsts {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    gap: 32px;
  }
  .first {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .first-n {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(3.6rem, 9vw, 8rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--orange);
  }
  .first h3 {
    margin-top: 8px;
    font-size: clamp(2.2rem, 5vw, 4.2rem);
  }
  .first p {
    margin-top: 10px;
    max-width: 26rem;
    font-size: 1.1rem;
    color: var(--stone-text);
  }

  /* Pinned: the section is tall, its inside sticks, and scrolling walks the route. */
  .story.is-pinned {
    height: 260vh;
  }
  @media (max-width: 760px) {
    .story.is-pinned {
      height: 200vh;
    }
  }
  .is-pinned .story-pin {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    padding-block: 96px 40px;
    overflow: hidden;
  }
  /* The mountain fills the pinned screen; the words sit on top of it. */
  .is-pinned :global(.mountain) {
    position: absolute;
    inset: 0;
    height: auto;
  }
  .is-pinned .story-inner {
    z-index: 1;
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    gap: 24px 48px;
    pointer-events: none;
  }
  .is-pinned .firsts {
    grid-row: 1;
    grid-column: 2;
    margin: 0;
  }
  /* The outgoing first leaves quickly and the next one comes in just after,
     so two never sit on top of each other. */
  .is-pinned .first {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.15s ease,
      transform 0.7s var(--ease-out);
  }
  .is-pinned .first.active {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.4s ease 0.12s,
      transform 0.7s var(--ease-out) 0.12s;
  }
  .is-pinned .first p {
    text-shadow: 0 1px 12px var(--page);
  }
  @media (max-width: 760px) {
    .is-pinned .story-inner {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr auto;
    }
    .is-pinned .firsts {
      grid-row: 3;
      grid-column: 1;
    }
    /* Keep the mountain between the heading and the words at the bottom. */
    .is-pinned :global(.mountain) {
      top: 20%;
      bottom: 26%;
    }
  }

  /* Activities */
  .activities {
    padding-bottom: clamp(80px, 12vw, 160px);
  }
  .act-head {
    padding-top: clamp(64px, 10vw, 120px);
  }
  .section-title {
    margin-top: 14px;
    font-size: clamp(2.6rem, 6.5vw, 5.2rem);
  }
  .act-list {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .act {
    position: relative;
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 8px 24px;
    padding: 26px 12px;
    border-bottom: 1px solid var(--line);
    isolation: isolate;
  }
  .act::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--orange);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.5s var(--ease-out);
  }
  .act-name {
    font-size: clamp(2.4rem, 6vw, 5rem);
    transition:
      transform 0.5s var(--ease-out),
      color 0.3s ease;
  }
  .act-line {
    color: var(--stone-text);
    transition: color 0.3s ease;
  }
  @media (hover: hover) {
    .act:hover::before {
      transform: scaleY(1);
    }
    .act:hover .act-name {
      transform: translateX(12px);
    }
    .act:hover .act-name,
    .act:hover .act-line,
    .act:hover .act-n {
      color: var(--page);
    }
  }
  @media (max-width: 760px) {
    .act {
      grid-template-columns: 2.4rem minmax(0, 1fr);
      padding: 20px 4px;
    }
    .act-line {
      grid-column: 2;
    }
  }

  /* App */
  .app {
