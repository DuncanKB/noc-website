---
// A phone with the real app screens: swipe on touch screens, drag with a
// mouse, or use the arrows, the dots or the arrow keys. Like swiping between
// tabs in the app, the status bar and tab bar stay still and only the page
// slides; the highlighted tab follows. Screens: src/data/app-screens.ts, images
// made by `npm run screens`.
import { APP_SCREENS } from '../data/app-screens';
import { UI, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = UI[lang].showcase;
// The phone body's depth: thin slices behind the front, like a real iPhone's edge.
const EDGE = Array.from({ length: 18 }, (_, i) => i + 1);
---

<div class="showcase" data-showcase>
  <div class="stage" data-stage>
    <div class="phone">
      {EDGE.map((z) => <span class="edge" style={`--z: ${z}`} aria-hidden="true" />)}
      <span class="key key-action" aria-hidden="true"></span>
      <span class="key key-up" aria-hidden="true"></span>
      <span class="key key-down" aria-hidden="true"></span>
      <span class="key key-side" aria-hidden="true"></span>
      <span class="echo echo-2" aria-hidden="true"></span>
      <span class="echo echo-1" aria-hidden="true"></span>
      <span class="glare" aria-hidden="true"></span>
      <div class="screen">
        <img class="statusbar" src="/app/statusbar.webp" alt="" width="828" height="108" aria-hidden="true" />
        <div
          class="track"
          tabindex="0"
          role="group"
          aria-roledescription="carousel"
          aria-label={t.carousel}
          data-track
        >
          {
            APP_SCREENS.map((s, i) => (
              <figure class="slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} ${t.of} ${APP_SCREENS.length}: ${s.title}`}>
                <img
                  src={`/app/${s.file}`}
                  alt={s.alt[lang]}
                  width="828"
                  height="1512"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  draggable="false"
                />
              </figure>
            ))
          }
        </div>
        <div class="tabbar" aria-hidden="true">
          {
            APP_SCREENS.map((s, i) => (
              <img class:list={['tab', { on: i === 0 }]} src={`/app/tab-${s.file}`} alt="" width="828" height="178" data-tab={i} />
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="controls">
    <button class="arrow" type="button" data-prev aria-label={t.prev}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <div class="caption" aria-live="polite">
      <span class="label label-orange" data-title>{APP_SCREENS[0].title}</span>
      <span class="caption-text" data-caption>{APP_SCREENS[0].caption[lang]}</span>
    </div>
    <button class="arrow" type="button" data-next aria-label={t.next}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>
  <div class="dots">
    {
      APP_SCREENS.map((s, i) => (
        <button
          class="dot"
          type="button"
          data-dot={i}
          data-title={s.title}
          data-caption={s.caption[lang]}
          aria-label={`${t.show} ${s.title}`}
          aria-current={i === 0 ? 'true' : undefined}
        />
      ))
    }
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-showcase]')) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const title = root.querySelector<HTMLElement>('[data-title]')!;
    const caption = root.querySelector<HTMLElement>('[data-caption]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Titles and captions (in the page's language) are on the dots.
    const count = dots.length;
    let current = 0;

    // Load the other screens once the phone is almost in view, so a swipe never
    // lands on an empty screen (they're small: ~40 KB each).
    const imgs = [...root.querySelectorAll('img')];
    const tabs = [...root.querySelectorAll<HTMLElement>('[data-tab]')];
    new IntersectionObserver(
      (entries, io) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        imgs.forEach((img) => (img.loading = 'eager'));
        io.disconnect();
      },
      { rootMargin: '400px 0px' },
    ).observe(root);

    const show = (i: number) => {
      if (i === current) return;
      current = i;
      title.textContent = dots[i].dataset.title ?? '';
      caption.textContent = dots[i].dataset.caption ?? '';
      tabs.forEach((t, j) => t.classList.toggle('on', j === i));
      dots.forEach((d, j) => (j === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      prev.disabled = i === 0;
      next.disabled = i === count - 1;
    };
    prev.disabled = true;

    const goTo = (i: number) => {
      const target = Math.max(0, Math.min(count - 1, i));
      track.scrollTo({ left: target * track.clientWidth, behavior: reduced ? 'auto' : 'smooth' });
    };

    // Follow the scroll position, however it moved (swipe, drag, buttons).
    let raf = 0;
    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => show(Math.round(track.scrollLeft / track.clientWidth)));
      },
      { passive: true },
    );

    prev.addEventListener('click', () => goTo(current - 1));
    next.addEventListener('click', () => goTo(current + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') goTo(current + 1);
      else if (e.key === 'ArrowLeft') goTo(current - 1);
      else if (e.key === 'Home') goTo(0);
      else if (e.key === 'End') goTo(count - 1);
      else return;
      e.preventDefault();
    });

    // Drag with a mouse, like a finger on a phone. Touch already swipes natively.
    let dragX: number | null = null;
    let dragStart = 0;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragX = e.clientX;
      dragStart = track.scrollLeft;
      track.classList.add('dragging');
      track.setPointerCapture(e.pointerId);
    });
    track.addEventListener('pointermove', (e) => {
      if (dragX === null) return;
      track.scrollLeft = dragStart - (e.clientX - dragX);
    });
    const endDrag = (e: PointerEvent) => {
      if (dragX === null) return;
      const moved = e.clientX - dragX;
      dragX = null;
      track.classList.remove('dragging');
      // A short flick is enough to move one screen.
      const base = Math.round(dragStart / track.clientWidth);
      goTo(Math.abs(moved) > track.clientWidth * 0.15 ? base - Math.sign(moved) : base);
    };
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);

    // The phone arrives in 3D as the section scrolls in (--a: 0 → 1), and
    // leans toward a mouse pointer (--mx, --my: -1 → 1).
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    if (reduced) {
      stage.style.setProperty('--a', '1');
    } else {
      let ticking = false;
      const arrive = () => {
        ticking = false;
        const r = stage.getBoundingClientRect();
        const a = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight * 0.55 + r.height * 0.5)));
        stage.style.setProperty('--a', a.toFixed(4));
      };
      addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(arrive);
          }
        },
        { passive: true },
      );
      arrive();
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        stage.addEventListener('pointermove', (e) => {
          const r = stage.getBoundingClientRect();
          stage.style.setProperty('--mx', (((e.clientX - r.left) / r.width) * 2 - 1).toFixed(3));
          stage.style.setProperty('--my', (((e.clientY - r.top) / r.height) * 2 - 1).toFixed(3));
        });
        stage.addEventListener('pointerleave', () => {
          stage.style.setProperty('--mx', '0');
          stage.style.setProperty('--my', '0');
        });
      }
    }
  }
</script>

<style>
  /* Echoes: two orange outlines of the phone stacked behind it in depth. They
     fan out while the phone is turned away and fold into it as it arrives. */
  .echo {
    position: absolute;
    inset: 0;
    border-radius: 50px;
    border: 1.5px solid var(--orange);
    box-shadow: 0 0 18px color-mix(in srgb, var(--orange) 45%, transparent);
    pointer-events: none;
  }
  .echo-1 {
    transform: translateZ(calc(var(--away) * -170px - 1px));
    opacity: calc(var(--away) * 0.75);
  }
  .echo-2 {
    transform: translateZ(calc(var(--away) * -340px - 2px));
    opacity: calc(var(--away) * 0.4);
  }
  /* Light catching the glass, moving with the tilt. */
  .glare {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: 50px;
    pointer-events: none;
    background: linear-gradient(
      calc(115deg + var(--mx) * 20deg),
      transparent 30%,
      rgb(255 255 255 / calc(0.05 + var(--a) * 0.05)) 45%,
      transparent 60%
    );
    background-size: 100% 200%;
    background-position: 0 calc(50% + var(--my) * 30% + var(--away) * 60%);
  }
  .showcase {
    display: grid;
    justify-items: center;
    gap: 18px;
  }
  .stage {
    --a: 0;
    --mx: 0;
    --my: 0;
    --away: calc(1 - var(--a));
    perspective: 1100px;
    position: relative;
    display: grid;
    place-items: center;
    padding-block: 12px;
  }
  .phone {
    transform: translateY(calc(var(--away) * 90px)) rotateX(calc(var(--away) * 26deg + 5deg + var(--my) * -12deg))
      rotateY(calc(var(--away) * -32deg - 14deg + var(--mx) * 20deg)) rotateZ(calc(var(--away) * 6deg))
      scale(calc(0.86 + var(--a) * 0.14));
    transition: transform 0.35s var(--ease-out);
    transform-style: preserve-3d;
    position: relative;
    width: min(300px, 72vw);
    padding: 11px;
    border-radius: 50px;
    background: linear-gradient(145deg, #5a5a5a, #1a1a1a 60%);
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.1);
  }
  /* The edge: slices of titanium-grey stacked behind the front. Only their rims
     show, so together they read as the phone's rounded side. */
  .edge {
    position: absolute;
    inset: 0;
    border-radius: 50px;
    transform: translateZ(calc(var(--z) * -1.5px));
    background: linear-gradient(90deg, #9a9a9a, #3c3c3c 12%, #262626 50%, #3c3c3c 88%, #9a9a9a);
    pointer-events: none;
  }
  /* The back slice carries the shadow on the page. */
  .edge:nth-of-type(18) {
    box-shadow: 0 50px 90px -25px rgb(0 0 0 / 0.8);
  }
  /* Buttons on the sides, halfway into the depth. */
  .key {
    position: absolute;
    width: 4px;
    border-radius: 2px;
    transform: translateZ(-13px);
    background: linear-gradient(90deg, #8a8a8a, #4a4a4a);
    pointer-events: none;
  }
  .key-action,
  .key-up,
  .key-down {
    left: -3px;
  }
  .key-action {
    top: 17%;
    height: 5%;
  }
  .key-up {
    top: 26%;
    height: 9%;
  }
  .key-down {
    top: 37%;
    height: 9%;
  }
  .key-side {
    right: -3px;
    top: 28%;
    height: 14%;
  }
  .screen {
    position: relative;
    aspect-ratio: 828 / 1798;
    border-radius: 40px;
    overflow: hidden;
    background: var(--page);
    isolation: isolate;
  }
  /* Status bar and tab bar sit still; only the page in between slides.
     Heights are the parts' share of the 828 × 1798 screen. */
  .statusbar,
  .tabbar {
    position: absolute;
    left: 0;
    width: 100%;
    z-index: 1;
    pointer-events: none;
  }
  .statusbar {
    top: 0;
    height: calc(108 / 1798 * 100%);
  }
  .tabbar {
    bottom: 0;
    height: calc(178 / 1798 * 100%);
  }
  .tab {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .tab.on {
    opacity: 1;
  }
  .track {
    position: absolute;
    top: calc(108 / 1798 * 100%);
    left: 0;
    width: 100%;
    height: calc(1512 / 1798 * 100%);
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    cursor: grab;
    touch-action: pan-x pan-y;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track.dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
  }
  .track:focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: -3px;
  }
  .slide {
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }
  .slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }

  .controls {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
    align-items: center;
    gap: 12px;
    width: min(340px, 86vw);
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--control);
    background: transparent;
    color: var(--ice);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .arrow svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .arrow:hover:not(:disabled) {
    border-color: var(--orange);
    background: var(--orange);
    color: var(--page);
  }
  .arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .caption {
    display: grid;
    justify-items: center;
    gap: 4px;
    text-align: center;
    min-height: 3.2em;
  }
  .caption-text {
    /* No lone last word on narrow screens. */
    text-wrap: balance;
    font-family: var(--display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 1.35rem;
    line-height: 1.05;
  }
  .dots {
    display: flex;
    gap: 4px;
  }
  /* Small dots, but each one is a 28px tap target. */
  .dot {
    position: relative;
    width: 28px;
    height: 28px;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
  }
  .dot::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 8px;
    height: 8px;
    translate: -50% -50%;
    border-radius: 99px;
    background: var(--dot); /* 3:1 or more against the page */
    transition:
      width 0.3s var(--ease-out),
      background-color 0.3s ease;
  }
  .dot[aria-current='true']::after {
    width: 22px;
    background: var(--orange);
  }
  .dot:hover::after {
    background: var(--ice);
  }
  .dot[aria-current='true']:hover::after {
    background: var(--orange);
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      scroll-behavior: auto;
    }
  }
</style>
