---
// The support page, in English (/support, the App Store "Support URL") and
// Dutch (/nl/support). Every answer here must match the app and the privacy
// policy (/privacy); when either changes, check both languages here too.
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL, DISCORD, INSTAGRAM, INSTAGRAM_HANDLE } from '../links';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const CONTACT = CONTACT_EMAIL;
const mail = `<a href="mailto:${CONTACT}">${CONTACT}</a>`;
const discord = (text: string) => `<a href="${DISCORD}" rel="noopener">${text}</a>`;

const COPY = {
  en: {
    title: 'Support — NEVERMADE OUTDOOR CLUB',
    description:
      'Get help with the NEVERMADE OUTDOOR CLUB app: contact, account deletion, privacy and answers to common questions.',
    home: '/',
    lede: 'Questions about the app, your account or your data? We’re a small team and we read everything.',
    emailLabel: 'Email',
    emailSub: 'Account, privacy, bugs and anything else',
    community: 'Community',
    discordSub: 'Questions, ideas and the people you’ll go out with',
    follow: 'Follow',
    faqLabel: 'Common questions',
    more: 'How we handle your data is in the <a href="/privacy">privacy policy</a>.',
    faqs: [
      {
        q: 'What is NEVERMADE OUTDOOR CLUB?',
        a: `<p>NOC is an outdoor app and community for chasing your firsts: your first summit, first trail run, first sunrise hike, first night outside. It’s not about being the fastest. You record your outings, keep a list of the firsts you’re after and share them with people who get it.</p>`,
      },
      {
        q: 'Is the app out yet? Is there an Android version?',
        a: `<p>The app is being built right now and comes to iPhone first, with Android after that. Leave your email on the <a href="/#waitlist">home page</a> to hear when it launches, or join the ${discord('Discord')} to follow along.</p>`,
      },
      {
        q: 'What does it cost? What is NOC+?',
        a: `<p>NOC+ will be an optional membership with extras. The details and pricing aren’t final yet; the Discord hears first. If you subscribe through the App Store, Apple handles the payment and you manage or cancel it in your iPhone’s Settings → your name → Subscriptions.</p>`,
      },
      {
        q: 'Who can see my activities?',
        a: `<p>New activities are private by default: only you see them. When you share an outing you choose “stats only” (the route stays private) or “route and stats”, and whether the post is for everyone or only your followers.</p>`,
      },
      {
        q: 'Why does the app ask for my location?',
        a: `<p>To record your route while you’re out, and to find parks and trailheads near you. If you allow it, recording keeps going while your screen is locked, so your route doesn’t stop. Location is only used while the app is in use or while a recording you started is running. You can change this any time in your iPhone’s Settings → Privacy &amp; Security → Location Services. The <a href="/privacy">privacy policy</a> has the details.</p>`,
      },
      {
        q: 'How do I delete my account?',
        a: `<p>In the app, go to Settings → Delete account. This deletes your profile, profile photo, activities, routes, firsts, posts, comments, likes and follows. If you can’t get into the app, email ${mail} from the address you signed up with.</p>`,
      },
      {
        q: 'Someone is being abusive. What can I do?',
        a: `<p>Use the report option on the post, comment or profile in the app; moderators review every report. You can also block people. For anything urgent or serious, email ${mail}.</p>`,
      },
      {
        q: 'I found a bug or have an idea.',
        a: `<p>Tell us. Email ${mail} (a screenshot and your iPhone model help) or post it in the ${discord('Discord')}, where the app is shaped together.</p>`,
      },
    ],
  },
  nl: {
    title: 'Support — NEVERMADE OUTDOOR CLUB',
    description:
      'Hulp bij de NEVERMADE OUTDOOR CLUB-app: contact, je account verwijderen, privacy en antwoorden op veelgestelde vragen.',
    home: '/nl',
    lede: 'Vragen over de app, je account of je gegevens? We zijn een klein team en we lezen alles.',
    emailLabel: 'E-mail',
    emailSub: 'Account, privacy, bugs en al het andere',
    community: 'Community',
    discordSub: 'Vragen, ideeën en de mensen met wie je op pad gaat',
    follow: 'Volg',
    faqLabel: 'Veelgestelde vragen',
    more: 'Hoe we met je gegevens omgaan staat in het <a href="/privacy" hreflang="en">privacybeleid</a> (in het Engels).',
    faqs: [
      {
        q: 'Wat is NEVERMADE OUTDOOR CLUB?',
        a: `<p>NOC is een outdoor-app en community voor je eerste keren: je eerste top, eerste trailrun, eerste zonsopgangtocht, eerste nacht buiten. Het gaat er niet om wie het snelst is. Je legt je tochten vast, houdt een lijst bij van de eerste keren die je nog wilt doen en deelt ze met mensen die het snappen.</p>`,
      },
      {
        q: 'Is de app al uit? Komt er een Android-versie?',
        a: `<p>De app wordt nu gebouwd en komt eerst naar de iPhone, daarna naar Android. Laat je e-mailadres achter op de <a href="/nl#waitlist">homepagina</a> om te horen wanneer hij uitkomt, of kom in de ${discord('Discord')} om mee te kijken.</p>`,
      },
      {
        q: 'Wat kost het? Wat is NOC+?',
        a: `<p>NOC+ wordt een optioneel lidmaatschap met extra’s. De details en prijzen staan nog niet vast; de Discord hoort het als eerste. Als je een abonnement neemt via de App Store, regelt Apple de betaling en beheer of stop je het in de Instellingen van je iPhone → je naam → Abonnementen.</p>`,
      },
      {
        q: 'Wie kan mijn activiteiten zien?',
        a: `<p>Nieuwe activiteiten zijn standaard privé: alleen jij ziet ze. Als je een tocht deelt, kies je “alleen statistieken” (de route blijft privé) of “route en statistieken”, en of het bericht voor iedereen is of alleen voor je volgers.</p>`,
      },
      {
        q: 'Waarom vraagt de app om mijn locatie?',
        a: `<p>Om je route vast te leggen terwijl je onderweg bent, en om parken en startpunten bij jou in de buurt te vinden. Als je het toestaat, gaat de opname door als je scherm vergrendeld is, zodat je route niet stopt. Je locatie wordt alleen gebruikt terwijl je de app gebruikt of terwijl een opname loopt die jij hebt gestart. Je kunt dit altijd aanpassen in de Instellingen van je iPhone → Privacy en beveiliging → Locatievoorzieningen. In het <a href="/privacy" hreflang="en">privacybeleid</a> (Engels) staan de details.</p>`,
      },
      {
        q: 'Hoe verwijder ik mijn account?',
        a: `<p>Ga in de app naar Settings → Delete account. Dit verwijdert je profiel, profielfoto, activiteiten, routes, eerste keren, berichten, reacties, likes en volgers. Kom je niet meer in de app? Mail dan naar ${mail} vanaf het adres waarmee je je hebt aangemeld.</p>`,
      },
      {
        q: 'Iemand gedraagt zich vervelend. Wat kan ik doen?',
        a: `<p>Gebruik de meldoptie bij het bericht, de reactie of het profiel in de app; moderators bekijken elke melding. Je kunt mensen ook blokkeren. Voor iets dringends of ernstigs mail je naar ${mail}.</p>`,
      },
      {
        q: 'Ik heb een bug gevonden of een idee.',
        a: `<p>Laat het ons weten. Mail naar ${mail} (een screenshot en je iPhone-model helpen) of zet het in de ${discord('Discord')}, waar we de app samen vormgeven.</p>`,
      },
    ],
  },
};
const c = COPY[lang];
const faqs = c.faqs;
---

<Base title={c.title} description={c.description} lang={lang} translated>
  <article class="wrap support">
    <a href={c.home} class="label back">← NEVERMADE OUTDOOR CLUB</a>
    <h1>Support</h1>
    <p class="lede">{c.lede}</p>

    <div class="contact">
      <a class="contact-card primary" href={`mailto:${CONTACT}?subject=NOC%20support`}>
        <span class="label">{c.emailLabel}</span>
        <span class="contact-main">{CONTACT}</span>
        <span class="contact-sub">{c.emailSub}</span>
      </a>
      <a class="contact-card" href={DISCORD} rel="noopener">
        <span class="label label-orange">{c.community}</span>
        <span class="contact-main">Discord</span>
        <span class="contact-sub">{c.discordSub}</span>
      </a>
      <a class="contact-card" href={INSTAGRAM} rel="noopener">
        <span class="label label-orange">{c.follow}</span>
        <span class="contact-main">Instagram</span>
        <span class="contact-sub">{INSTAGRAM_HANDLE}</span>
      </a>
    </div>

    <section class="faq" aria-labelledby="faq-title">
      <p class="label label-orange">{c.faqLabel}</p>
      <h2 id="faq-title">FAQ</h2>
      <div class="faq-list">
        {
          faqs.map((f) => (
            <details>
              <summary>
                <span>{f.q}</span>
                <span class="plus" aria-hidden="true" />
              </summary>
              <div class="answer" set:html={f.a} />
            </details>
          ))
        }
      </div>
    </section>

    <p class="more" set:html={c.more} />
  </article>
</Base>

<style>
  .support {
    max-width: 820px;
    padding-block: 48px 96px;
  }
  .back {
    text-decoration: none;
    display: inline-block;
    padding: 6px 0;
  }
  .back:hover {
    color: var(--ice);
  }
  h1 {
    margin-top: 28px;
    font-size: clamp(3.6rem, 13vw, 6.5rem);
    line-height: 0.85;
  }
  .lede {
    margin-top: 20px;
    max-width: 34rem;
    font-size: 1.15rem;
  }

  .contact {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .contact-card {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 22px 22px 24px;
    border-radius: 20px;
    /* Page colour, not surface: the small orange labels need it for contrast. */
    background: var(--page);
    border: 1px solid var(--card-edge);
    text-decoration: none;
    transition:
      transform 0.4s var(--ease-out),
      border-color 0.2s ease;
  }
  .contact-card:hover {
    transform: translateY(-3px);
    border-color: var(--orange);
  }
  .contact-card.primary {
    grid-column: 1 / -1;
    background: var(--orange);
    border-color: var(--orange);
    color: var(--page);
  }
  .contact-card.primary .label {
    color: var(--page);
  }
  .contact-card.primary:focus-visible {
    outline-color: var(--ice);
  }
  .contact-main {
    margin-top: 6px;
    font-family: var(--display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.7rem, 5.2vw, 2.6rem);
    line-height: 1;
    overflow-wrap: anywhere;
  }
  .contact-sub {
    font-size: 0.95rem;
    color: var(--stone-text);
  }
  /* An email address reads (and copies) better in its own case. */
  .primary .contact-main {
    /* Sized to fit on one line down to 360px wide. */
    font-size: min(2.6rem, 6.1vw);
    overflow-wrap: normal;
    white-space: nowrap;
    text-transform: none;
    letter-spacing: -0.01em;
  }
  @media (max-width: 560px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
  .primary .contact-sub {
    color: var(--page);
    font-weight: 500;
  }

  .faq {
    margin-top: 72px;
  }
  .faq h2 {
    margin-top: 12px;
    font-size: clamp(2.6rem, 8vw, 4rem);
  }
  .faq-list {
    margin-top: 28px;
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 4px;
    cursor: pointer;
    list-style: none;
    font-family: var(--display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.3rem, 3.6vw, 1.7rem);
    line-height: 1.05;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--orange);
  }
  .plus {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    inset: 8px 0 auto;
    height: 2px;
    background: var(--orange);
    transition: transform 0.3s var(--ease-out);
  }
  .plus::after {
    transform: rotate(90deg);
  }
  details[open] .plus::after {
    transform: rotate(0deg);
  }
  .answer {
    padding: 0 4px 24px;
    max-width: 40rem;
    color: color-mix(in srgb, var(--ice) 88%, transparent);
  }
  .answer :global(a),
  .more :global(a) {
    color: var(--orange);
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .more {
    margin-top: 40px;
    color: var(--stone-text);
  }
</style>
