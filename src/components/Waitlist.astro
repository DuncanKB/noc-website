---
import { CONTACT_EMAIL } from '../links';
import { HOME, UI, type Lang } from '../i18n';
// "Tell me when the app is out": one email field. Posts to /api/waitlist
// (worker/index.ts). Works without JavaScript too (the server redirects back
// with ?waitlist=ok / ?waitlist=error); with JavaScript it answers in place.
const CONTACT = CONTACT_EMAIL;

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = UI[lang].waitlist;
---

<form
  id="waitlist"
  class="waitlist"
  action="/api/waitlist"
  method="post"
  data-waitlist
  data-idle={t.idle}
  data-sending={t.sending}
  data-done={t.done}
  data-ok={t.ok}
  data-invalid={t.invalid}
  data-error={t.error}
  data-offline={t.offline}
  novalidate
>
  <label class="label label-orange" for="waitlist-email">{t.label}</label>
  <!-- Where to come back to after a no-JavaScript submit. -->
  <input type="hidden" name="from" value={HOME[lang]} />
  <div class="wl-row">
    <input
      id="waitlist-email"
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      required
      maxlength="254"
      placeholder={t.placeholder}
      aria-describedby="waitlist-note waitlist-msg"
    />
    <!-- Bots fill every field; people never see this one. -->
    <div class="wl-hp" aria-hidden="true">
      <label for="waitlist-company">Company</label>
      <input id="waitlist-company" name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <button class="btn wl-btn" type="submit">
      <span class="wl-label" data-label>{t.idle}</span>
      <svg class="wl-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
    </button>
  </div>
  <p id="waitlist-msg" class="wl-msg" role="status" aria-live="polite"></p>
  <p id="waitlist-note" class="wl-note">
    {t.note} <a href={`mailto:${CONTACT}`}>{CONTACT}</a>.
  </p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-waitlist]');
  const msg = form?.querySelector<HTMLElement>('.wl-msg');
  const button = form?.querySelector<HTMLButtonElement>('button');
  const label = form?.querySelector<HTMLElement>('[data-label]');
  // The words, in the page's language, come from the form's data-* attributes.
  const text = (key: 'idle' | 'sending' | 'done' | 'ok' | 'invalid' | 'error' | 'offline') => form?.dataset[key] ?? '';
  const say = (text: string, ok: boolean) => {
    if (!form || !msg) return;
    msg.textContent = text;
    form.classList.toggle('is-ok', ok);
    form.classList.toggle('is-error', !ok);
  };
  // The button shows what's happening: idle → sending → done.
  const setState = (state: 'idle' | 'sending' | 'done') => {
    if (!form || !button || !label) return;
    form.dataset.state = state;
    label.textContent = text(state);
    button.disabled = state === 'sending';
    button.setAttribute('aria-busy', String(state === 'sending'));
  };

  // Result after a no-JavaScript submit.
  const result = new URLSearchParams(location.search).get('waitlist');
  if (result === 'ok') {
    say(text('ok'), true);
    setState('done');
  }
  if (result === 'invalid') say(text('invalid'), false);
  if (result === 'error') say(text('error'), false);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = form.querySelector<HTMLInputElement>('input[name=email]')!;
    if (!input.checkValidity() || !input.value.trim()) {
      say(text('invalid'), false);
      input.focus();
      return;
    }
    setState('sending');
    let done = false;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { accept: 'application/json' },
        body: new FormData(form),
      });
      const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
      if (res.ok && data.ok) {
        say(text('ok'), true);
        form.reset();
        done = true;
      } else if (data.error === 'invalid') {
        say(text('invalid'), false);
      } else {
        say(text('error'), false);
      }
    } catch {
      say(text('offline'), false);
    } finally {
      setState(done ? 'done' : 'idle');
    }
  });

  // Typing a new address makes the button ready again.
  form?.querySelector('input[name=email]')?.addEventListener('input', () => {
    if (form.dataset.state === 'done') setState('idle');
  });
</script>

<style>
  .waitlist {
    margin-top: 36px;
    max-width: 32rem;
    display: grid;
    gap: 12px;
  }
  .wl-row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  input[type='email'] {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 52px;
    padding: 0 20px;
    border-radius: 999px;
    border: 1.5px solid var(--control);
    background: var(--surface);
    color: var(--ice);
    font: inherit;
    font-size: 1rem;
    transition: border-color 0.2s ease;
  }
  input[type='email']::placeholder {
    color: var(--placeholder);
  }
  input[type='email']:hover {
    border-color: var(--stone);
  }
  input[type='email']:focus-visible {
    outline: none;
    border-color: var(--orange);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--orange) 25%, transparent);
  }
  .btn {
    min-height: 52px;
  }
  /* A steady width, so the button doesn't jump between its states. */
  .wl-btn {
    gap: 0;
    min-width: 11.5em;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      transform 0.15s ease;
  }
  .wl-btn:disabled {
    cursor: progress;
  }
  [data-state='sending'] .wl-label {
    animation: wl-pulse 1s ease-in-out infinite;
  }
  @keyframes wl-pulse {
    50% {
      opacity: 0.55;
    }
  }
  .wl-check {
    width: 0;
    height: 1.1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    transition: width 0.3s ease;
  }
  /* Done: moss green (the app's success colour), a small pop, the tick draws itself. */
  [data-state='done'] .wl-btn {
    background: var(--moss);
    border-color: var(--moss);
    color: var(--page);
    animation: wl-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  [data-state='done'] .wl-check {
    width: 1.1em;
    margin-left: 0.45em;
    stroke-dashoffset: 0;
    transition:
      width 0.3s ease,
      stroke-dashoffset 0.45s ease 0.15s;
  }
  @keyframes wl-pop {
    40% {
      transform: scale(1.05);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-state='sending'] .wl-label,
    [data-state='done'] .wl-btn {
      animation: none;
    }
    .wl-check,
    [data-state='done'] .wl-check {
      transition: none;
    }
  }
  .wl-hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .wl-msg {
    min-height: 1.5em;
    font-weight: 500;
  }
  .is-ok .wl-msg {
    color: var(--ok);
  }
  .is-error .wl-msg {
    color: var(--warn);
  }
  .wl-note {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--stone-text);
  }
  .wl-note a {
    color: var(--ice);
    text-underline-offset: 3px;
  }
</style>
